      "l3": {
        "title": "Request lifecycle — full context",
        "width": "reading",
        "sections": [
          { "id": "path", "heading": "The edge-first path", "level": 1, "md": "Every request tries the edge first. Wake-word, STT, and intent all resolve on-device; only novel asks escalate to cloud. The broker executes the resolved action locally, so the round trip stays well under a human's perception threshold." },
          { "id": "budget", "heading": "Watching the context budget", "level": 2, "md": "The transcript tail is the first thing to overflow the window. Retrieval and tool schemas are bounded; the tail is not, so it is compacted first." }
        ]
      }
